<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DwmFix</AssemblyName>
    <RootNamespace>DwmFix.App</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>Anezium; Arccalc</Authors>
    <Description>Native Windows tray utility to keep DWM composition active on selected monitors.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DwmFix.Core\DwmFix.Core.csproj" />
  </ItemGroup>
</Project>
